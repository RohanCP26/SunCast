{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.11",
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        "cd frontend && npm ci && CI=false REACT_APP_API_URL= npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd backend && python App.py",
    "variables": {
      "DEBUG": "False"
    }
  }
}
